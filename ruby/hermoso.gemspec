# frozen_string_literal: true

# Hand-written. lib/ is generated by tools/sdk-generate.mjs (openapi-generator `ruby`, Faraday) plus the overlay/ helpers.
require_relative 'lib/hermoso/version'

Gem::Specification.new do |s|
  s.name        = 'hermoso'
  s.version     = Hermoso::VERSION
  s.summary     = 'Typed Ruby client for the Hermoso API.'
  s.description = 'Generate image and video ads, publish and schedule posts, read analytics, and call every Hermoso tool from your own backend.'
  s.authors     = ['Hermoso']
  s.email       = ['hello@hermoso.ai']
  s.homepage    = 'https://hermoso.ai/docs/sdks/'
  s.license     = 'MIT'
  s.required_ruby_version = '>= 3.1'
  s.metadata = {
    'homepage_uri' => 'https://hermoso.ai/docs/sdks/',
    'documentation_uri' => 'https://hermoso.ai/docs/api/',
    'source_code_uri' => 'https://github.com/hermoso-ai/hermoso-sdks/tree/main/ruby',
    'bug_tracker_uri' => 'https://github.com/hermoso-ai/hermoso-sdks/issues',
    'rubygems_mfa_required' => 'true'
  }
  s.files = Dir['lib/**/*.rb'] + ['README.md', 'LICENSE']
  s.require_paths = ['lib']
  s.add_dependency 'faraday', '>= 1.0.1', '< 3.0'
  s.add_dependency 'faraday-multipart', '~> 1.0'
  s.add_dependency 'marcel', '~> 1.0'
end
