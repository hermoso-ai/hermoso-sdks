{
    "name": "hermoso/sdk",
    "description": "Typed PHP client for the Hermoso API: generate ads, publish and schedule posts, read analytics, and call every Hermoso tool from your own backend.",
    "type": "library",
    "keywords": ["hermoso", "api", "sdk", "openapi", "ads", "ad generation", "social media", "scheduling", "marketing"],
    "homepage": "https://hermoso.ai/docs/sdks/",
    "license": "MIT",
    "authors": [{ "name": "Hermoso", "email": "hello@hermoso.ai", "homepage": "https://hermoso.ai" }],
    "support": {
        "issues": "https://github.com/hermoso-ai/hermoso-sdks/issues",
        "source": "https://github.com/hermoso-ai/hermoso-sdks",
        "docs": "https://hermoso.ai/docs/sdks/"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0",
        "psr/http-client": "^1.0"
    },
    "autoload": {
        "psr-4": { "Hermoso\\": "php/lib/" }
    },
    "archive": {
        "exclude": ["/typescript", "/python", "/go", "/ruby", "/java", "/dotnet", "/rust", "/openapi.json"]
    }
}
